# Copie este arquivo para ".env" e preencha os valores reais
PORT=3000

# Token da sua conta Apify (Configurações > Integrations > API tokens em apify.com)
APIFY_TOKEN=

# Actor do Apify usado para captura de leads (Google Maps Scraper)
APIFY_ACTOR_ID=compass~crawler-google-places

# Intervalo minimo/maximo (em segundos) entre disparos de WhatsApp, para reduzir risco de bloqueio
DISPARO_INTERVALO_MIN=18
DISPARO_INTERVALO_MAX=35
